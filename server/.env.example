# Local development defaults
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (never commit the real value)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>

# Optional Gemini free-tier key. Keep billing disabled and never use a VITE_ prefix.
# If unset or quota is exhausted, the assistant uses catalog-based fallback.
GEMINI_API_KEY=
